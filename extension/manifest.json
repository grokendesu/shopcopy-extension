{
  "manifest_version": 3,
  "name": "ShopCopy",
  "version": "1.0.0",
  "description": "Write SEO title, meta, body HTML, and 13 tags on a Shopify product edit page.",
  "action": {
    "default_title": "ShopCopy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://admin.shopify.com/*"],
      "js": ["generate.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
